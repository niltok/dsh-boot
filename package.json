{
  "name": "dsh-boot",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight lifecycle launcher for the DeepSeek Harness (dsh) web server",
  "type": "module",
  "scripts": {
    "test": "node --test packages/cli/test/*.test.js",
    "bundle": "node scripts/bundle-runtime.mjs",
    "package:linux": "node scripts/package-linux.mjs",
    "package:macos": "node scripts/package-macos.mjs",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/wix-build.ps1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
