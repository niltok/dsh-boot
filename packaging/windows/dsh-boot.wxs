<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="dsh-boot"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="dsh-boot contributors"
           UpgradeCode="9e06d43b-3f51-4f9b-9e2c-8e24c7d7b1c4"
           Scope="perUserOrMachine">
    <SummaryInformation Description="Lightweight DeepSeek Harness (dsh) launcher" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of dsh-boot is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPCOMMENTS" Value="One MSI, two scopes: per-user writes HKCU Environment, per-machine writes HKLM Environment." />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ApplicationFolderName" Value="dsh-boot" />
    <Property Id="DSH_BOOT_SCOPE" Secure="yes" />
    <Property Id="WixAppFolder" Value="WixPerUserFolder" />
    <WixVariable Id="WixUISupportPerUser" Value="1" />
    <WixVariable Id="WixUISupportPerMachine" Value="1" />

    <!-- Silent-install default is always the current user. Even elevated
         installs default to per-user unless the user explicitly chooses
         "all users" on the InstallScopeDlg. Conditions key off DSH_BOOT_SCOPE
         so the execute sequence cannot override the UI choice. -->
    <SetProperty Id="DSH_BOOT_SCOPE" Action="SetDefaultUserScope" Before="CostFinalize" Value="user" Condition="DSH_BOOT_SCOPE=&quot;&quot;" />
    <SetProperty Id="DSH_BOOT_SCOPE" Action="SetMachineScope" Before="CostFinalize" Value="machine" Condition="DSH_BOOT_SCOPE=&quot;machine&quot;" />
    <SetProperty Id="ALLUSERS" Action="SetDefaultAllUsersPerUser" Before="CostFinalize" Value="{}" Condition="DSH_BOOT_SCOPE=&quot;&quot; OR DSH_BOOT_SCOPE=&quot;user&quot;" />
    <SetProperty Id="ALLUSERS" Action="SetDefaultAllUsersMachine" Before="CostFinalize" Value="1" Condition="DSH_BOOT_SCOPE=&quot;machine&quot;" />
    <SetProperty Id="WixAppFolder" Action="SetDefaultWixAppFolderPerUser" Before="CostFinalize" Value="WixPerUserFolder" Condition="DSH_BOOT_SCOPE=&quot;&quot; OR DSH_BOOT_SCOPE=&quot;user&quot;" />
    <SetProperty Id="WixAppFolder" Action="SetDefaultWixAppFolderPerMachine" Before="CostFinalize" Value="WixPerMachineFolder" Condition="DSH_BOOT_SCOPE=&quot;machine&quot;" />
    <SetProperty Id="APPLICATIONFOLDER" Action="SetDefaultAppFolderPerUser" Before="CostFinalize" Value="[LocalAppDataFolder]Apps\[ApplicationFolderName]" Condition="DSH_BOOT_SCOPE=&quot;&quot; OR DSH_BOOT_SCOPE=&quot;user&quot;" />
    <SetProperty Id="APPLICATIONFOLDER" Action="SetDefaultAppFolderPerMachine" Before="CostFinalize" Value="[ProgramFiles64Folder][ApplicationFolderName]" Condition="DSH_BOOT_SCOPE=&quot;machine&quot;" />

    <ui:WixUI Id="DshBootInstallDir" InstallDirectory="APPLICATIONFOLDER" />

    <Feature Id="MainFeature" Title="dsh-boot" Level="1">
      <ComponentGroupRef Id="RuntimeComponents" />
      <ComponentRef Id="StartMenuShortcutUserComponent" />
      <ComponentRef Id="StartMenuShortcutMachineComponent" />
      <ComponentRef Id="RunAutostartUserComponent" />
      <ComponentRef Id="RunAutostartMachineComponent" />
      <ComponentRef Id="MachinePathComponent" />
    </Feature>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcutUserComponent" Condition="NOT ALLUSERS">
        <Shortcut Id="StartMenuShortcutUser"
                  Name="DSH Boot"
                  Description="Start the DeepSeek Harness web service and open the web UI"
                  Target="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"
                  Arguments="-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File &quot;[APPLICATIONFOLDER]scripts\dsh-boot-launch.ps1&quot; launch"
                  WorkingDirectory="APPLICATIONFOLDER"
                  Icon="DshBootIcon" />
        <RegistryValue Root="HKCU" Key="Software\dsh-boot" Name="startMenuShortcutUser" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="StartMenuShortcutMachineComponent" Condition="ALLUSERS">
        <Shortcut Id="StartMenuShortcutMachine"
                  Name="DSH Boot"
                  Description="Start the DeepSeek Harness web service and open the web UI"
                  Target="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"
                  Arguments="-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File &quot;[APPLICATIONFOLDER]scripts\dsh-boot-launch.ps1&quot; launch"
                  WorkingDirectory="APPLICATIONFOLDER"
                  Icon="DshBootIcon" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKLM" Key="Software\dsh-boot" Name="startMenuShortcutMachine" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="APPLICATIONFOLDER">
      <Component Id="MachinePathComponent" Condition="ALLUSERS">
        <Environment Id="MachinePath" Name="Path" Action="set" Part="last" System="yes" Value="[APPLICATIONFOLDER]bin" />
        <RegistryValue Root="HKMU" Key="Software\dsh-boot" Name="machinePath" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="RunAutostartUserComponent" Condition="NOT ALLUSERS">
        <RegistryValue Root="HKCU"
                      Key="Software\Microsoft\Windows\CurrentVersion\Run"
                      Name="DSH Boot"
                      Type="string"
                      Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File &quot;[APPLICATIONFOLDER]scripts\dsh-boot-launch.ps1&quot; start"
                      KeyPath="yes" />
      </Component>
      <Component Id="RunAutostartMachineComponent" Condition="ALLUSERS">
        <RegistryValue Root="HKLM"
                      Key="Software\Microsoft\Windows\CurrentVersion\Run"
                      Name="DSH Boot"
                      Type="string"
                      Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File &quot;[APPLICATIONFOLDER]scripts\dsh-boot-launch.ps1&quot; start"
                      KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <CustomAction Id="AddUserPath"
                  Directory="SystemFolder"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -Command &quot;&amp; { $ErrorActionPreference='Stop'; $Action=$args[0]; $Target=$args[1]; $cur=(Get-ItemProperty -Path 'HKCU:\Environment' -Name Path -ErrorAction SilentlyContinue).Path; if($null -eq $cur){$cur=''}; $entries=@($cur -split ';' | Where-Object { $_ -ne '' }); $norm=$Target.TrimEnd('\').ToLowerInvariant(); $remaining=@($entries | Where-Object { $_.TrimEnd('\').ToLowerInvariant() -ne $norm }); if($Action -eq 'add'){ if($remaining.Count -eq $entries.Count){ $remaining += $Target } }; Set-ItemProperty -Path 'HKCU:\Environment' -Name Path -Value ($remaining -join ';') -Type ExpandString; Start-Process -FilePath ($env:SystemRoot+'\System32\rundll32.exe') -ArgumentList 'user32.dll,UpdatePerUserSystemParameters' -WindowStyle Hidden }&quot; add &quot;[APPLICATIONFOLDER]bin&quot;"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="check" />

    <CustomAction Id="RemoveUserPath"
                  Directory="SystemFolder"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -Command &quot;&amp; { $ErrorActionPreference='Stop'; $Action=$args[0]; $Target=$args[1]; $cur=(Get-ItemProperty -Path 'HKCU:\Environment' -Name Path -ErrorAction SilentlyContinue).Path; if($null -eq $cur){$cur=''}; $entries=@($cur -split ';' | Where-Object { $_ -ne '' }); $norm=$Target.TrimEnd('\').ToLowerInvariant(); $remaining=@($entries | Where-Object { $_.TrimEnd('\').ToLowerInvariant() -ne $norm }); if($Action -eq 'add'){ if($remaining.Count -eq $entries.Count){ $remaining += $Target } }; Set-ItemProperty -Path 'HKCU:\Environment' -Name Path -Value ($remaining -join ';') -Type ExpandString; Start-Process -FilePath ($env:SystemRoot+'\System32\rundll32.exe') -ArgumentList 'user32.dll,UpdatePerUserSystemParameters' -WindowStyle Hidden }&quot; remove &quot;[APPLICATIONFOLDER]bin&quot;"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="AddUserPath" After="InstallValidate" Condition="NOT Installed AND NOT ALLUSERS" />
      <Custom Action="RemoveUserPath" After="InstallValidate" Condition="REMOVE=&quot;ALL&quot; AND NOT ALLUSERS" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="APPLICATIONFOLDER" Name="dsh-boot" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="DSH Boot" />
    </StandardDirectory>
  </Package>

  <Fragment>
    <UI Id="DshBootInstallDir_X64">
      <Publish Dialog="LicenseAgreementDlg" Control="Print" Event="DoAction" Value="WixUIPrintEula_X64" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction" Value="WixUIValidatePath_X64" Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="WixUIValidatePath_X64" Order="2" Condition="NOT WIXUI_DONTVALIDATEPATH" />
    </UI>
    <UIRef Id="DshBootInstallDir" />
  </Fragment>

  <Fragment>
    <UI Id="file DshBootInstallDir">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />

      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Publish Dialog="BrowseDlg" Control="OK" Event="SpawnDialog" Value="InvalidDirDlg" Order="4" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="1" Condition="LicenseAccepted = &quot;1&quot;" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="InstallScopeDlg" Order="2" Condition="LicenseAccepted = &quot;1&quot; AND Privileged" />

      <DialogRef Id="InstallScopeDlg" />

      <Publish Dialog="InstallScopeDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" />
      <Publish Dialog="InstallScopeDlg" Control="Next" Property="ALLUSERS" Value="{}" Order="1" Condition="WixAppFolder=&quot;WixPerUserFolder&quot;" />
      <Publish Dialog="InstallScopeDlg" Control="Next" Property="ALLUSERS" Value="1" Order="2" Condition="WixAppFolder=&quot;WixPerMachineFolder&quot;" />
      <Publish Dialog="InstallScopeDlg" Control="Next" Property="DSH_BOOT_SCOPE" Value="user" Order="3" Condition="WixAppFolder=&quot;WixPerUserFolder&quot;" />
      <Publish Dialog="InstallScopeDlg" Control="Next" Property="DSH_BOOT_SCOPE" Value="machine" Order="4" Condition="WixAppFolder=&quot;WixPerMachineFolder&quot;" />
      <Publish Dialog="InstallScopeDlg" Control="Next" Property="APPLICATIONFOLDER" Value="[LocalAppDataFolder]Apps\[ApplicationFolderName]" Order="5" Condition="WixAppFolder=&quot;WixPerUserFolder&quot;" />
      <Publish Dialog="InstallScopeDlg" Control="Next" Property="APPLICATIONFOLDER" Value="[ProgramFiles64Folder][ApplicationFolderName]" Order="6" Condition="WixAppFolder=&quot;WixPerMachineFolder&quot;" />
      <Publish Dialog="InstallScopeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="7" />

      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="InstallScopeDlg" Order="2" Condition="NOT Installed AND Privileged" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidDirDlg" Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="4" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

      <Property Id="ARPNOMODIFY" Value="1" />
    </UI>

    <UIRef Id="WixUI_Common" />
  </Fragment>

  <Fragment>
    <Icon Id="DshBootIcon" SourceFile="$(var.SourceDir)\dsh-boot.ico" />
  </Fragment>
</Wix>
